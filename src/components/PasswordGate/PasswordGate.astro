---
import { createCipheriv, pbkdf2Sync, randomBytes } from 'node:crypto';

const password = import.meta.env.ABOUT_PRIVATE_PASSWORD;

if (!password) {
  throw new Error('ABOUT_PRIVATE_PASSWORD is required to build password-protected content.');
}

const iterations = 600000;
const salt = randomBytes(16);
const iv = randomBytes(12);
const key = pbkdf2Sync(password, salt, iterations, 32, 'sha256');
const html = await Astro.slots.render('default');
const cipher = createCipheriv('aes-256-gcm', key, iv);
const encrypted = Buffer.concat([cipher.update(html, 'utf8'), cipher.final(), cipher.getAuthTag()]);

const payload = {
  ciphertext: encrypted.toString('base64'),
  salt: salt.toString('base64'),
  iv: iv.toString('base64'),
  iterations,
};
---

<section class="vh-password-gate" data-password-gate data-payload={JSON.stringify(payload)}>
  <form class="vh-password-gate-form" data-password-form>
    <h3>隐私内容已锁定</h3>
    <p>请输入密码查看剩余内容。</p>
    <label>
      <span>访问密码</span>
      <input data-password-input type="password" autocomplete="current-password" inputmode="text" required />
    </label>
    <button type="submit">解锁</button>
    <p class="vh-password-gate-error" data-password-error hidden>密码不正确，请再试一次。</p>
  </form>
  <section class="vh-password-gate-content" data-password-content></section>
</section>

<style>
  .vh-password-gate {
    margin: 1.5rem 0;
  }

  .vh-password-gate-form {
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem;
    border: 1px solid rgba(125, 125, 125, 0.24);
    border-radius: 8px;
    background: rgba(125, 125, 125, 0.06);
  }

  .vh-password-gate-form[hidden] {
    display: none;
  }

  .vh-password-gate-form h3,
  .vh-password-gate-form p {
    margin: 0;
  }

  .vh-password-gate-form label {
    display: grid;
    gap: 0.35rem;
  }

  .vh-password-gate-form input {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid rgba(125, 125, 125, 0.36);
    border-radius: 6px;
    padding: 0.65rem 0.75rem;
    color: inherit;
    background: var(--vh-main-bg, #fff);
  }

  .vh-password-gate-form button {
    width: fit-content;
    border: 0;
    border-radius: 6px;
    padding: 0.6rem 1rem;
    color: #fff;
    background: var(--vh-theme-color, #3b82f6);
    cursor: pointer;
  }

  .vh-password-gate-form button:disabled {
    cursor: wait;
    opacity: 0.72;
  }

  .vh-password-gate-error {
    color: #d14343;
  }

  .vh-password-gate-content:empty {
    display: none;
  }
</style>

<script is:inline>
  (() => {
    const textEncoder = new TextEncoder();
    const textDecoder = new TextDecoder();

    const base64ToBytes = (value) => {
      const binary = atob(value);
      const bytes = new Uint8Array(binary.length);
      for (let i = 0; i < binary.length; i += 1) bytes[i] = binary.charCodeAt(i);
      return bytes;
    };

    const unlockGate = async (gate, password) => {
      const payload = JSON.parse(gate.dataset.payload || '{}');
      const keyMaterial = await crypto.subtle.importKey(
        'raw',
        textEncoder.encode(password),
        'PBKDF2',
        false,
        ['deriveKey']
      );
      const key = await crypto.subtle.deriveKey(
        {
          name: 'PBKDF2',
          salt: base64ToBytes(payload.salt),
          iterations: payload.iterations,
          hash: 'SHA-256',
        },
        keyMaterial,
        { name: 'AES-GCM', length: 256 },
        false,
        ['decrypt']
      );
      const decrypted = await crypto.subtle.decrypt(
        { name: 'AES-GCM', iv: base64ToBytes(payload.iv) },
        key,
        base64ToBytes(payload.ciphertext)
      );
      return textDecoder.decode(decrypted);
    };

    const setupPasswordGates = () => {
      document.querySelectorAll('[data-password-gate]:not([data-password-gate-ready])').forEach((gate) => {
        gate.setAttribute('data-password-gate-ready', 'true');
        const form = gate.querySelector('[data-password-form]');
        const input = gate.querySelector('[data-password-input]');
        const error = gate.querySelector('[data-password-error]');
        const content = gate.querySelector('[data-password-content]');
        const button = form?.querySelector('button[type="submit"]');

        form?.addEventListener('submit', async (event) => {
          event.preventDefault();
          if (!input?.value) return;
          if (button) button.disabled = true;
          if (error) error.hidden = true;

          try {
            content.innerHTML = await unlockGate(gate, input.value);
            form.hidden = true;
          } catch {
            if (error) error.hidden = false;
            input.select();
          } finally {
            if (button) button.disabled = false;
          }
        });
      });
    };

    setupPasswordGates();
    document.addEventListener('astro:page-load', setupPasswordGates);
    document.addEventListener('swup:contentReplaced', setupPasswordGates);
  })();
</script>
